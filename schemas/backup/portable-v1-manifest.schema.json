{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nuriteo:schema:backup:portable-v1-manifest",
  "title": "NURITEO portable backup manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "backupId", "createdBy", "database", "requiredFeatures", "entries", "extensions"],
  "properties": {
    "format": { "const": "nuriteo-portable" },
    "formatVersion": { "const": 1 },
    "backupId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
    "createdBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": { "version": { "type": "string", "minLength": 1, "maxLength": 128 } }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "archiveFormat"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "archiveFormat": { "const": "postgres-custom" }
      }
    },
    "requiredFeatures": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 100 },
          "kind": { "enum": ["database_archive", "payload"] },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" }
    }
  }
}
