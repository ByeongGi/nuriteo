{
  "schemaVersion": 1,
  "updatedAt": "2026-09-16",
  "scope": {
    "goal": "Select public Vite React projects and freeze the scoring rubric for ecosystem compatibility.",
    "productRuntime": "browser-guest-node-runtime",
    "referenceRuntime": "host-node-reference-harness",
    "minimumPassForMilestoneB": 7,
    "fixtureCount": 10
  },
  "scoringRubric": {
    "totalPoints": 100,
    "criteria": [
      {
        "id": "install",
        "points": 25,
        "description": "Package manager install completes without unsupported native or postinstall blockers."
      },
      {
        "id": "dev-preview",
        "points": 25,
        "description": "Dev server starts, preview loads, and core application content renders."
      },
      {
        "id": "edit-hmr",
        "points": 25,
        "description": "A source edit updates served modules through HMR without losing client state."
      },
      {
        "id": "build-dist",
        "points": 25,
        "description": "Production build completes and generated dist output passes a static smoke check."
      }
    ],
    "classification": {
      "pass": "score >= 80 and no unsupported blocker",
      "partial-pass": "score >= 50 or one recoverable product-runtime gap",
      "hold": "requires unsupported-but-replaceable dependency, missing lockfile migration, or non-critical Node API gap",
      "unsupported": "requires Docker, direct TCP database, native addon without browser/WASM fallback, or arbitrary Linux binary"
    }
  },
  "referenceNodeBaseline": {
    "status": "install-build-measured",
    "node": ">=22.23.0 <23",
    "packageManagers": ["npm", "pnpm"],
    "commands": [
      "install",
      "dev",
      "preview",
      "source-edit-hmr",
      "build",
      "dist-smoke"
    ],
    "evidenceRequired": [
      "install log",
      "build log",
      "dist file list",
      "dev server URL",
      "browser screenshot or DOM assertion",
      "HMR event log"
    ]
  },
