{
  "schemaVersion": 1,
  "updatedAt": "2026-09-23",
  "status": "p24-reliability-policy",
  "memory": {
    "heapCeilingMiB": 256,
    "source": "compat/performance-baseline.json#runtime-memory-heap-limit",
    "enforcement": "node-worker-v8-limit-and-guest-workspace-byte-limit",
    "nodeWorkerV8OldGenerationLimitMiB": 256,
    "guestWorkspaceLimitBytes": 268435456,
    "browserWorkerHeapEnforcement": "hold-unobservable-from-host"
  },
  "timeouts": {
    "installMs": 120000,
    "cliWorkerMs": 90000,
    "devServerIdleMs": 600000,
    "previewRelayMs": 1500
  },
  "storage": {
    "quotaBytesDefault": 268435456,
    "evictionPrefixes": ["cache/", "packages/"],
    "protectedPrefixes": ["projects/"],
    "writerLeaseTtlMs": 30000
  },
  "soak": {
    "bootRunTeardownIterations": 1000,
    "installDevRestartIterationsDefault": 25,
    "largeNodeModulesFileCount": 2500
  },
  "browserGrades": {
    "chrome": "supported",
    "edge": "supported",
    "safari": "hold"
  },
  "browserGradeNotes": {
    "chrome": "Primary gate browser with COOP/COEP and SharedArrayBuffer.",
    "edge": "Microsoft Edge 153 desktop smoke passes COOP/COEP, SharedArrayBuffer, Service Worker activation, and Vite React preview.",
    "safari": "Hold until SharedArrayBuffer + cross-origin isolation + OPFS/Service Worker preview routing are validated on desktop Safari."
  },
  "holdFixtures": []
}
