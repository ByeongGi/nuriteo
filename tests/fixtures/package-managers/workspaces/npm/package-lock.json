{
  "name": "npm-workspace-fixture",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "npm-workspace-fixture",
      "version": "1.0.0",
      "hasInstallScript": true,
      "workspaces": [
        "packages/*"
      ],
      "dependencies": {
        "fixture-bin": "file:packages/fixture-bin",
        "fixture-optional": "file:packages/fixture-optional",
        "fixture-peer-consumer": "file:packages/fixture-peer-consumer",
        "fixture-peer-provider": "file:packages/fixture-peer-provider"
      }
    },
    "node_modules/fixture-bin": {
      "resolved": "packages/fixture-bin",
      "link": true
    },
    "node_modules/fixture-optional": {
      "resolved": "packages/fixture-optional",
      "link": true
    },
    "node_modules/fixture-peer-consumer": {
      "resolved": "packages/fixture-peer-consumer",
      "link": true
    },
    "node_modules/fixture-peer-provider": {
      "resolved": "packages/fixture-peer-provider",
      "link": true
    },
    "packages/fixture-bin": {
      "version": "1.0.0",
      "bin": {
        "fixture-hello": "bin/fixture-hello.js"
      }
    },
    "packages/fixture-optional": {
      "version": "1.0.0",
      "hasInstallScript": true
    },
    "packages/fixture-peer-consumer": {
      "version": "1.0.0",
      "peerDependencies": {
        "fixture-peer-provider": "^1.0.0"
      }
    },
    "packages/fixture-peer-provider": {
      "version": "1.0.0"
    }
  }
