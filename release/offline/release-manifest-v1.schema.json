{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nuriteo:offline-release-manifest:v1",
  "title": "NURITEO Offline Release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseLineage", "release", "sourceCommit", "createdAt", "inventorySha256", "bundles", "licenses", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseLineage": { "const": "nuriteo-self-hosted-v1" },
    "release": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "inventorySha256": { "$ref": "#/$defs/sha256" },
    "bundles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required"],
        "properties": {
          "id": { "enum": ["core", "quickstart"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "spdx", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "spdx": { "type": "string", "minLength": 1, "maxLength": 128 },
          "source": {
            "type": "string",
            "anyOf": [
              { "format": "uri", "pattern": "^https://" },
              { "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" }
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bundle", "kind", "path", "bytes", "sha256", "licenseRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "bundle": { "enum": ["core", "quickstart"] },
        "kind": { "enum": ["attestation", "configuration", "helm-chart", "license", "metadata", "oci-digest", "oci-image", "sbom", "script", "trust-material"] },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "ociDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sbomRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "licenseRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "oci-image" } }, "required": ["kind"] },
          "then": { "required": ["ociDigest", "sbomRefs"] },
          "else": { "not": { "required": ["ociDigest"] } }
        }
      ]
    }
  }
}
