#!/bin/sh
set -eu

root=${1:?usage: verify-install BUNDLE_ROOT REGISTRY NAMESPACE OUTPUT_DIR EGRESS_CIDR...}
registry=${2:?registry host is required}
namespace=${3:?registry namespace is required}
output=${4:?output directory is required}
shift 4
[ "$#" -gt 0 ] || { echo 'at least one external dependency CIDR is required' >&2; exit 1; }
[ ! -e "$output" ] || { echo 'output directory already exists' >&2; exit 1; }
parent=$(dirname "$output")
[ -d "$parent" ] || { echo 'output parent directory is missing' >&2; exit 1; }
command -v helm >/dev/null 2>&1 || { echo 'helm is required' >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo 'jq is required' >&2; exit 1; }

for cidr in "$@"; do
  [ "$(printf '%s\n' "$cidr" | wc -l | tr -d ' ')" = 1 ] &&
    printf '%s\n' "$cidr" | grep -Eq '^[0-9A-Fa-f:.]+/[0-9]{1,3}$' || {
      echo "invalid external dependency CIDR: $cidr" >&2; exit 1;
    }
  case "$cidr" in 0.0.0.0/0|'::/0') echo 'unbounded external egress is forbidden' >&2; exit 1 ;; esac
  address=${cidr%/*}
  prefix=${cidr#*/}
  case "$address" in
    *:*) [ "$prefix" -le 128 ] || { echo "invalid IPv6 prefix: $cidr" >&2; exit 1; } ;;
    *) printf '%s\n' "$address" | awk -F. '
         NF != 4 { exit 1 }
         { for (i = 1; i <= 4; i++) if ($i !~ /^[0-9]+$/ || $i > 255) exit 1 }
       ' && [ "$prefix" -le 32 ] || { echo "invalid IPv4 CIDR: $cidr" >&2; exit 1; } ;;
  esac
done

stage=$(mktemp -d "$parent/.nuriteo-airgap-install.XXXXXX")
cleanup() { rm -rf -- "$stage"; }
trap cleanup EXIT HUP INT TERM
"$(dirname "$0")/render-config" "$root" "$registry" "$namespace" "$stage/configuration" >/dev/null
values="$stage/configuration/helm-values-airgap.yaml"
{
  printf '\nnetworkPolicy:\n  enabled: true\n  externalEgress:\n    cidrBlocks:\n'
  for cidr in "$@"; do printf '      - "%s"\n' "$cidr"; done
} >>"$values"

chart="$root/core/helm/nuriteo-0.1.0.tgz"
[ -f "$chart" ] || { echo 'bundled Helm chart is missing' >&2; exit 1; }
rendered="$stage/rendered-install.yaml"
helm template nuriteo "$chart" --values "$values" \
  --set toolbox.enabled=true --set toolbox.operation=list >"$rendered"

[ "$(grep -c '^kind: NetworkPolicy$' "$rendered")" -eq 4 ] || {
  echo 'restricted network policy set is incomplete' >&2; exit 1;
}
if grep -Eq '(^|[[:space:]"/])(docker\.io|ghcr\.io|quay\.io|registry\.k8s\.io)([/"[:space:]]|$)' "$rendered"; then
  echo 'rendered install contains a public registry reference' >&2; exit 1
fi
images="$stage/images.txt"
sed -n 's/^[[:space:]]*image:[[:space:]]*"\{0,1\}\([^"[:space:]]*\)"\{0,1\}[[:space:]]*$/\1/p' "$rendered" \
  | LC_ALL=C sort -u >"$images"
[ -s "$images" ] || { echo 'rendered install contains no workload images' >&2; exit 1; }
while IFS= read -r image; do
  case "$image" in
    "${registry}/${namespace}/"*@sha256:????????????????????????????????????????????????????????????????) ;;
    *) echo "undeclared or unpinned workload image: $image" >&2; exit 1 ;;
  esac
  printf '%s\n' "${image##*@sha256:}" | grep -Eq '^[a-f0-9]{64}$' || {
    echo "invalid workload image digest: $image" >&2; exit 1;
  }
done <"$images"
expected_images="$stage/expected-images.txt"
jq -r --arg registry "${registry}/${namespace}" '
  .artifacts[] |
  select(.id == "server-image" or .id == "web-image" or .id == "operations-image") |
  "\($registry)/\(.id | sub("-image$"; ""))@\(.ociDigest)"
' "$root/release-manifest.json" | LC_ALL=C sort -u >"$expected_images"
cmp -s "$expected_images" "$images" || {
  echo 'rendered workload image set differs from the release manifest' >&2; exit 1;
}

jq -n \
  --arg releaseLineage "$(jq -r '.releaseLineage' "$root/release-manifest.json")" \
  --arg release "$(jq -r '.release' "$root/release-manifest.json")" \
  --arg registry "${registry}/${namespace}" \
  --argjson images "$(jq -Rsc 'split("\n") | map(select(length > 0))' <"$images")" \
  --argjson egressCidrs "$(printf '%s\n' "$@" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
  '{schemaVersion: 1, releaseLineage: $releaseLineage, release: $release, registry: $registry,
    workloadImages: $images, networkPolicy: {defaultDeny: true, externalEgressCidrs: $egressCidrs}}' \
  >"$stage/install-plan.json"

mv "$stage" "$output"
trap - EXIT HUP INT TERM
echo 'offline installation verified'
