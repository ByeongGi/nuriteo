{
  "name": "cargo-container",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.23.0 <23",
    "pnpm": ">=11.15.1 <12"
  },
  "scripts": {
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "test:rust": "cargo test --workspace",
    "build:wasm": "cargo build -p system-wasm --target wasm32-unknown-unknown",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check:node-upgrade": "node scripts/check-node-upgrade.mjs",
    "check:package-manager-upgrade": "node scripts/check-package-manager-upgrade.mjs",
    "check:performance-baseline": "node scripts/check-performance-baseline.mjs",
    "check:incident-playbook": "node scripts/check-incident-playbook.mjs",
    "check:release-policy": "node scripts/check-release-policy.mjs",
    "check:release-provenance": "node scripts/check-release-provenance.mjs",
    "check:release-operations": "node scripts/check-release-operations.mjs",
    "check:release-ops-sg29": "node scripts/check-release-ops-sg29.mjs",
    "check:release-readiness": "node scripts/check-release-readiness.mjs",
    "test:release-ops": "node tests/release-ops/rollback-rehearsal.test.mjs",
    "package:sdk": "node scripts/package-sdk.mjs",
    "package:sdk:fingerprint": "node scripts/package-sdk.mjs --write-fingerprint",
    "check:soak-baseline": "node scripts/check-soak-baseline.mjs",
    "check:runtime-reliability": "node scripts/check-runtime-reliability-policy.mjs",
    "check:service-backend": "node scripts/check-service-backend.mjs",
    "check:security-beta": "node scripts/check-security-beta.mjs",
    "check:observability-support": "node scripts/check-observability-support.mjs",
    "check:sg25": "node scripts/check-sg25.mjs",
    "check:sg30": "node scripts/check-sg30.mjs",
    "check:public-beta-readiness": "node scripts/check-public-beta-readiness.mjs",
    "test:vite-vue-svelte-actual": "node tests/vite/vite-vue-svelte-actual.test.mjs",
    "test:workflow-soak": "node tests/preview-service/workflow-soak.test.mjs",
    "test:large-node-modules-stress": "node tests/browser-host/large-node-modules-stress.test.mjs",
    "check:wasm-tool-adapters": "node scripts/check-wasm-tool-adapters.mjs",
    "check:wasi-boundary": "node scripts/check-wasi-boundary.mjs",
    "check:non-js-tooling": "node scripts/check-non-js-tooling-candidates.mjs",
    "check:native-fallback": "node scripts/check-native-fallback-policy.mjs",
    "inspect:vite-artifact": "node scripts/inspect-vite-package-artifact.mjs",
    "check:types": "tsc --noEmit",
    "test:protocol": "node tests/protocol/run.mjs",
    "test:node-runtime": "node tests/node-runtime/run.mjs",
    "test:browser-host": "node tests/browser-host/run.mjs",
    "test:package-managers": "node tests/package-managers/run.mjs",
    "test:preview": "node tests/preview/run.mjs",
    "test:vite": "node tests/vite/run.mjs",
    "test:sdk-consumer": "node tests/sdk-consumer/run.mjs",
    "test:worker-boot": "node experiments/worker-boot/check.mjs",
    "test:harness": "node tests/harness/self-test.mjs",
    "dev:lab": "node examples/runtime-lab/server.mjs",
    "dev:preview": "pnpm --filter @cargo-container/preview-service-app dev",
    "build:preview": "pnpm --filter @cargo-container/preview-service-app build",
    "test:preview-service": "node tests/preview-service/run.mjs",
    "test:browser": "node tests/browser/run.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
