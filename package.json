{
  "name": "nuriteo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.23.0 <23",
    "pnpm": ">=11.15.1 <12"
  },
  "scripts": {
