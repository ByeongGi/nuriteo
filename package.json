    "check:self-hosted-g0": "node tooling/checks/check-self-hosted-g0.ts",
    "check:node-upgrade": "node tooling/checks/check-node-upgrade.ts",
    "check:package-manager-upgrade": "node tooling/checks/check-package-manager-upgrade.ts",
    "check:performance-baseline": "node tooling/checks/check-performance-baseline.ts",
    "check:incident-playbook": "node tooling/checks/check-incident-playbook.ts",
    "check:release-policy": "node tooling/checks/check-release-policy.ts",
    "check:release-provenance": "node tooling/checks/check-release-provenance.ts",
