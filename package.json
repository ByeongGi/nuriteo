    "inspect:vite-artifact": "node tooling/checks/inspect-vite-package-artifact.ts",
    "check:types": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.migrated.json",
    "check:test-types": "tsc -p tsconfig.test.json",
    "check:tool-types": "tsc -p tsconfig.tools.json",
    "check:migrated-syntax": "tsc -p tsconfig.migrated.json",
    "test:protocol": "node packages/protocol/test/run.ts",
    "test:node-runtime": "node packages/node-runtime/test/run.ts",
    "test:browser-host": "node packages/browser-host/test/run.ts",
    "test:package-managers": "node tests/compatibility/package-managers/run.ts",
    "test:preview": "node packages/preview/test/run.ts",
    "test:vite": "node tests/compatibility/frameworks/vite/run.ts",
    "test:bundler-candidates": "node tests/compatibility/frameworks/bundlers/run.ts",
    "test:sdk-consumer": "node tests/contract/sdk-consumer/run.ts",
    "test:worker-boot": "node experiments/worker-boot/check.ts",
    "test:harness": "node tests/harness/self-test.ts",
    "dev:lab": "node examples/runtime-lab/server.ts",
    "dev:preview": "pnpm --filter @nuriteo/preview-service-app dev",
    "build:preview": "pnpm --filter @nuriteo/preview-service-app build",
    "test:preview-service": "node apps/preview-service/test/run.ts",
    "test:safari-browser": "node apps/preview-service/test/safari-browser-smoke.test.ts",
    "test:next-full-runtime": "node --experimental-strip-types apps/preview-service/test/next-full-runtime.test.ts",
    "test:next-browser-worker": "node --experimental-strip-types apps/preview-service/test/next-browser-worker.test.ts",
    "check:nextjs-runtime": "node tooling/checks/check-nextjs-runtime.ts",
    "test:bundler-browser": "BUNDLER_LANE=webpack node --experimental-strip-types apps/preview-service/test/bundler-browser-worker.test.ts && BUNDLER_LANE=rspack node --experimental-strip-types apps/preview-service/test/bundler-browser-worker.test.ts",
    "test:browser": "node tests/system/browser/run.ts"
