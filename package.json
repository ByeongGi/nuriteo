    "@rspack/cli": "2.2.4",
    "@rspack/core": "2.2.4",
    "@rspack/dev-server": "1.2.1",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@types/node": "^22.20.2",
    "@types/react": "19.0.3",
    "@wasmer/sdk": "0.18.0",
    "client-only": "0.0.1",
    "jq-wasm": "3.0.0-jq-1.8.2",
    "next": "15.5.26",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "6.0.3",
    "wasm-git": "0.0.17",
    "webpack": "5.111.0",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "5.2.2"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
