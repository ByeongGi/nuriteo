    "check:sdk-public-release": "node tooling/checks/check-sdk-public-release.ts",
    "check:soak-baseline": "node tooling/checks/check-soak-baseline.ts",
    "check:runtime-reliability": "node tooling/checks/check-runtime-reliability-policy.ts",
    "check:service-backend": "node tooling/checks/check-service-backend.ts",
    "check:service-backend-production": "node tooling/checks/check-service-backend-production.ts",
    "check:security-beta": "node tooling/checks/check-security-beta.ts",
    "check:observability-support": "node tooling/checks/check-observability-support.ts",
