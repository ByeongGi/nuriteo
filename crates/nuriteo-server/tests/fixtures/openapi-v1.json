{
  "openapi": "3.1.0",
  "info": {
    "title": "NURITEO Public API",
    "description": "Versioned public REST API for a self-hosted NURITEO instance.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current self-hosted instance"
    }
  ],
  "paths": {
    "/api/v1/auth/session": {
      "delete": {
        "tags": [
          "authentication"
        ],
        "operationId": "delete_session",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "description": "Exact configured canonical origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Exact double-submit CSRF credential",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked or already inactive; returns separate deletion Set-Cookie headers"
          },
          "403": {
            "description": "Origin, CSRF or cookie security policy rejected the request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sessions": {
      "post": {
        "tags": [
          "authentication"
        ],
        "operationId": "create_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Session created; returns separate Session and CSRF Set-Cookie headers"
          },
          "401": {
            "description": "Generic local authentication failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds the bounded limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Request is not singular application/json",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Request fields are invalid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "authentication"
        ],
        "operationId": "current_user",
        "responses": {
          "200": {
            "description": "Current active User and safe Session metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            }
          },
          "401": {
            "description": "Session is missing, invalid, expired or revoked",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "version",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "description": "Optional caller correlation ID. Invalid or duplicate values are replaced.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Server release version",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Validated or server-generated correlation ID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Validated or server-generated correlation ID"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FieldViolation": {
        "type": "object",
        "required": [
          "path",
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID"
          },
          "detail": {
            "type": "string",
            "example": "The field is invalid."
          },
          "path": {
            "type": "string",
            "example": "name"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@example.test",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 1024
          }
        },
        "additionalProperties": false
      },
      "MeSession": {
        "type": "object",
        "required": [
          "id",
          "last_seen_at",
          "idle_expires_at",
          "absolute_expires_at"
        ],
        "properties": {
          "absolute_expires_at": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "idle_expires_at": {
            "type": "string"
          },
          "last_seen_at": {
            "type": "string"
          }
        }
      },
      "MeUser": {
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name",
          "is_instance_admin"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "is_instance_admin": {
            "type": "boolean"
          }
        }
      },
      "MeView": {
        "type": "object",
        "required": [
          "user",
          "session"
        ],
        "properties": {
          "session": {
            "$ref": "#/components/schemas/MeSession"
          },
          "user": {
            "$ref": "#/components/schemas/MeUser"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "request_id",
          "errors"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "detail": {
            "type": "string",
            "example": "One or more fields are invalid."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            }
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/projects"
          },
          "request_id": {
            "type": "string",
            "example": "0199ee6c-c777-7000-8000-000000000001"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "example": 422,
            "minimum": 0
          },
          "title": {
            "type": "string",
            "example": "Validation failed"
          },
          "type": {
            "type": "string",
            "example": "/docs/problems/validation-failed"
          }
        }
      },
      "VersionResponse": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "string",
            "example": "0.1.0"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Public instance compatibility information"
    },
    {
      "name": "authentication",
      "description": "Local browser Session lifecycle"
    }
  ]
}
