{
  "openapi": "3.1.0",
  "info": {
    "title": "NURITEO Public API",
    "description": "Versioned public REST API for a self-hosted NURITEO instance.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current self-hosted instance"
    }
  ],
  "paths": {
    "/api/v1/admin/activation-invitations": {
      "get": {
        "tags": [
          "invitations"
        ],
        "operationId": "list_invitations",
        "responses": {
          "200": {
            "description": "Bounded safe invitation metadata without activation credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Active Session required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Instance Administrator required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "invitations"
        ],
        "operationId": "issue_invitation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Invitation issued; activation URL is returned once",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedInvitationView"
                }
              }
            }
          },
          "401": {
            "description": "Active Session required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Instance Administrator, exact Origin and CSRF required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Invalid or conflicting invitation request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/activation-invitations/{invitation_id}": {
      "delete": {
        "tags": [
          "invitations"
        ],
        "operationId": "revoke_invitation",
        "parameters": [
          {
            "name": "invitation_id",
            "in": "path",
            "description": "UUIDv7 invitation identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Invitation revoked or already inactive"
          },
          "403": {
            "description": "Administrator browser security policy rejected the request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/activation-invitations/{invitation_id}/reissue": {
      "post": {
        "tags": [
          "invitations"
        ],
        "operationId": "reissue_invitation",
        "parameters": [
          {
            "name": "invitation_id",
            "in": "path",
            "description": "UUIDv7 invitation identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReissueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Replacement issued; activation URL is returned once",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedInvitationView"
                }
              }
            }
          },
          "403": {
            "description": "Administrator browser security policy rejected the request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Invitation is inactive or request is invalid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/activation": {
      "post": {
        "tags": [
          "invitations"
        ],
        "operationId": "activate_invitation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Account and Personal Workspace activated; no Session is created"
          },
          "403": {
            "description": "Exact canonical Origin required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Activation input or invitation is invalid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "delete": {
        "tags": [
          "authentication"
        ],
        "operationId": "delete_session",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "description": "Exact configured canonical origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Exact double-submit CSRF credential",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked or already inactive; returns separate deletion Set-Cookie headers"
          },
          "403": {
            "description": "Origin, CSRF or cookie security policy rejected the request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sessions": {
      "post": {
        "tags": [
          "authentication"
        ],
        "operationId": "create_session",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "description": "Exact configured canonical origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Session created; returns separate Session and CSRF Set-Cookie headers"
          },
          "401": {
            "description": "Generic local authentication failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Origin security policy rejected the request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds the bounded limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Request is not singular application/json",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Request fields are invalid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "authentication"
        ],
        "operationId": "current_user",
        "responses": {
          "200": {
            "description": "Current active User and safe Session metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            }
          },
          "401": {
            "description": "Session is missing, invalid, expired or revoked",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/organization-invitations/accept": {
      "post": {
        "tags": [
          "organization-invitations"
        ],
        "operationId": "accept_invitation",
