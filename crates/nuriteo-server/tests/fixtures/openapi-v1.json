        }
      }
    },
    "/api/v1/me/workspaces": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "operationId": "current_workspaces",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "description": "Optional caller correlation ID. Invalid or duplicate values are replaced.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workspaces visible to the current active User",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceCollectionView"
                }
              }
            }
          },
          "401": {
            "description": "Session is missing, invalid, expired or revoked, or its User is unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Workspace persistence invariants could not be satisfied",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/organizations": {
      "post": {
        "tags": [
          "organizations"
        ],
        "operationId": "create_organization",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrganizationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Organization created with creator as Owner",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Strong Organization version validator"
              },
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Canonical Organization URL"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationView"
                }
              }
            }
          },
          "401": {
            "description": "Active Session required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Exact Origin and CSRF required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Slug conflicts with an existing Organization",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{organization_id}": {
