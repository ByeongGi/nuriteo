{
  "name": "@nuriteo/web",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm runtime:assets && next build && node tooling/canonicalize-next-output.mjs",
    "dev": "pnpm runtime:assets && next dev",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "next start",
    "runtime:assets": "node --experimental-strip-types tooling/build-runtime-assets.ts",
    "test": "node --conditions=react-server test/run.ts",
    "test:browser-entry": "node test/browser-entry.test.ts",
    "test:browser-shell": "node test/authenticated-shell-browser.test.ts",
    "test:browser-admin-settings": "node test/admin-settings-browser.test.ts",
    "test:browser-admin-updates": "node test/admin-updates-browser.test.ts",
    "test:browser-admin-backups": "node test/admin-backups-browser.test.ts",
    "test:browser-mfa": "node test/mfa-browser.test.ts",
    "test:browser-oidc": "node test/oidc-browser.test.ts",
    "test:browser-registry": "node test/registry-browser.test.ts",
    "test:browser-git-provider": "node test/git-provider-browser.test.ts",
    "test:browser-notifications": "node test/notification-browser.test.ts",
    "test:browser-collaboration": "node test/collaboration-browser.test.ts",
    "test:browser-project": "node test/project-browser.test.ts",
    "test:browser-team": "node test/team-browser.test.ts",
    "test:browser-published-example": "node test/published-example-browser.test.ts",
    "test:browser-published-preview": "node --experimental-strip-types test/published-preview-isolation-browser.test.ts",
    "test:runtime-browser": "node --experimental-strip-types test/runtime-journey-browser.test.ts",
    "test:runtime-recovery-browser": "node --experimental-strip-types test/runtime-recovery-browser.test.ts",
    "test:resume-browser": "node --experimental-strip-types test/resume-browser.test.ts",
    "test:history-browser": "node --experimental-strip-types test/project-history-browser.test.ts",
    "test:relay-browser-actual": "test/fixtures/private-relay/run.sh",
    "test:local-draft-writer-browser": "node --experimental-strip-types test/local-draft-writer-browser.test.ts",
    "test:preview-browser": "node --experimental-strip-types test/preview-subdomain-browser.test.ts",
    "test:preview-next-browser": "node --experimental-strip-types test/preview-next-subdomain-browser.test.ts",
    "test:preview-standalone": "node --experimental-strip-types test/preview-standalone.test.ts",
    "test:gate-project-runtime-browser": "node --experimental-strip-types test/gate-project-runtime-browser.test.ts",
    "test:bundle-boundary": "node test/bundle-boundary.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@nuriteo/api-client": "workspace:*",
    "@nuriteo/browser-host": "workspace:*",
    "@nuriteo/workspace-runtime": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "es-module-lexer": "2.3.2",
    "next": "15.5.26",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
